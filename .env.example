# Copy to .env for local development. Never commit real credentials.
RATERADAR_DATABASE_URL=postgresql://rateradar:rateradar@localhost:5432/rateradar

# Politeness: raise only if you know the banks tolerate it.
# RATERADAR_GLOBAL_CONCURRENCY=8
# RATERADAR_PER_HOST_CONCURRENCY=2

# Identify yourself. Put a real contact URL here before running against banks.
# RATERADAR_USER_AGENT=RateRadar/0.1 (+https://github.com/YOURNAME/rateradar)

# --- Grafana dashboard -------------------------------------------------------
# `make dash` uses the local compose Postgres and needs nothing here.
# `make dash-neon` derives Grafana's connection from the DSN above, or from this
# one if set. Prefer this: Grafana runs with anonymous Admin, and an Admin can
# run arbitrary SQL -- so give it a read-only role, not the collector's own
# credential. See docs/operations.md, "Pointing the dashboard at Neon".
# RATERADAR_GRAFANA_DATABASE_URL=postgresql://grafana_ro:PASSWORD@ep-xxx.ap-southeast-2.aws.neon.tech/rateradar?sslmode=require
